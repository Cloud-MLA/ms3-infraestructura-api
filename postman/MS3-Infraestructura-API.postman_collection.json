{
  "info": {
    "_postman_id": "7f1d3c2e-9a4b-4c5d-8e6f-0a1b2c3d4e5f",
    "name": "MS3 - Infraestructura / Incidencias API",
    "description": "Coleccion de endpoints para MS3 (Node.js + Express + MongoDB). Proyecto CS2032 - Cloud Computing. Base: /api/infra. Requiere MS2 corriendo en :8002 para los POST que validan vuelos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003",
      "type": "string"
    },
    {
      "key": "ms2Url",
      "value": "http://localhost:8002",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health / Docs",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "GET /api/infra/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/infra/health"
          }
        }
      ]
    },
    {
      "name": "Recursos",
      "item": [
        {
          "name": "GET listar recursos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/infra/recursos"
          }
        },
        {
          "name": "GET recursos filtro tipo=manga&estado=Libre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/infra/recursos?tipo=manga&estado=Libre"
          }
        },
        {
          "name": "GET recurso por id (numerico)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/infra/recursos/1"
          }
        },
        {
          "name": "POST crear manga",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/infra/recursos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"nombre_tecnico_locacion\": \"Espigon A - Puente A07\",\n  \"tipo\": \"manga\",\n  \"manga\": {\n    \"estado_acople\": \"Libre\",\n    \"longitud\": 24.5,\n    \"clase_max\": \"E\"\n  }\n}"
            }
          }
        },
        {
          "name": "POST crear radar (rango_alcance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/infra/recursos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 351,\n  \"nombre_tecnico_locacion\": \"TORRE - Radar Primario\",\n  \"tipo\": \"radar\",\n  \"radar\": {\n    \"rango_alcance\": 250,\n    \"frecuencia\": \"Banda S\"\n  }\n}"
            }
          }
        },
        {
          "name": "PATCH cambiar estado recurso",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/infra/recursos/1/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Ocupado\"\n}"
            }
          }
        }
      ]
    },
    {
